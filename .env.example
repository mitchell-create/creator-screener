# OpenRouter (for Gemini Flash - Tier 3)
AFF_OPENROUTER_API_KEY=your_openrouter_api_key_here
AFF_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Pipeline Settings
AFF_VIDEOS_PER_PROFILE=5
AFF_BATCH_SIZE=50
AFF_DOWNLOAD_CONCURRENCY=10
AFF_MAX_CONCURRENT_ANALYSIS=4
AFF_TEMP_DIR=/tmp/affiliate_pipeline

# Tier 1: Audio Thresholds
AFF_VAD_SPEECH_MIN_PCT=10.0
AFF_DNSMOS_OVRL_MIN=2.5
AFF_DNSMOS_SIG_MIN=2.0

# Tier 2: Video Thresholds
AFF_DOVER_OVERALL_MIN=0.45
AFF_DOVER_AESTHETIC_MIN=0.4
AFF_DOVER_TECHNICAL_MIN=0.4
AFF_MIN_SCENE_CUTS=2

# Tier Failure Rate (reject affiliate if more than this fraction of videos fail a tier)
AFF_TIER_FAILURE_RATE=0.5

# Tier 3: Gemini Settings
AFF_TIER3_ENABLED=true
AFF_BORDERLINE_BAND_PCT=15.0
AFF_GEMINI_MAX_FRAMES=4
AFF_GEMINI_MIN_SCORE=6.0
AFF_GEMINI_WEEKLY_BUDGET_USD=1.00

# Scoring Weights - Video Quality (should sum to 1.0)
AFF_WEIGHT_AUDIO=0.35
AFF_WEIGHT_VIDEO=0.35
AFF_WEIGHT_EDITS=0.15
AFF_WEIGHT_ENGAGEMENT=0.15

# Creator Enrichment & Scoring (Tier 0)
AFF_FIRECRAWL_API_KEY=your_firecrawl_api_key_here
AFF_ENRICHMENT_ENABLED=true
AFF_ENRICHMENT_CONCURRENCY=5

# Creator Score Weights (auto-normalized)
AFF_CREATOR_WEIGHT_ENGAGEMENT=0.35
AFF_CREATOR_WEIGHT_FOLLOWER_QUALITY=0.25
AFF_CREATOR_WEIGHT_CONSISTENCY=0.20
AFF_CREATOR_WEIGHT_AUTHENTICITY=0.20

# Pre-filter: reject creators below this score before video analysis (0.0 = disabled)
AFF_CREATOR_SCORE_MIN=0.0

# Brand-Fit Matching (optional, requires campaign brief)
AFF_BRAND_FIT_ENABLED=false
AFF_EMBEDDING_MODEL=openai/text-embedding-3-small
AFF_USE_LOCAL_EMBEDDINGS=false

# Discovery Mode
AFF_DISCOVERY_MAX_CREATORS=100
AFF_DISCOVERY_PLATFORMS=tiktok,instagram

# I/O Paths
AFF_INPUT_CSV_PATH=./data/input.csv
AFF_OUTPUT_CSV_PATH=./data/output.csv

# Slack Bot (required for --mode slack)
AFF_SLACK_BOT_TOKEN=xoxb-your-bot-token
AFF_SLACK_APP_TOKEN=xapp-your-app-level-token
AFF_SLACK_CHANNEL_ID=C0AL4Q5RCEP
